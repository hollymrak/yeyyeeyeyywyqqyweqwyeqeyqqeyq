local cloneref = cloneref or clonereference or function(x) return x end
local Players = cloneref(game:GetService("Players"))
local TS = cloneref(game:GetService("TweenService"))
local UIS = cloneref(game:GetService("UserInputService"))
local CoreGui = cloneref(game:GetService("CoreGui"))
local HttpService = cloneref(game:GetService("HttpService"))
local RunService = cloneref(game:GetService("RunService"))
local LP = Players.LocalPlayer
local Mouse = LP:GetMouse()

local function HttpGet(url)
	local ok, res = pcall(function()
		return game:HttpGet(url)
	end)
	return ok and res or nil
end

local Lucide
do
	local src = HttpGet("https://raw.githubusercontent.com/eeeiqjjj/icon.github.io/refs/heads/main/lucide.lua")
	if src then
		local fn = loadstring(src)
		if fn then
			local ok, mod = pcall(fn)
			if ok then Lucide = mod end
		end
	end
	Lucide = Lucide or { GetAsset = function() return nil end }
end

local function iconAsset(name)
	if not name or name == "" then return nil end
	name = tostring(name):match("([^:]+)$") or name
	local a = Lucide.GetAsset and Lucide.GetAsset(name)
	if not a then return nil end
	local url = a.Url
	if type(url) == "string" and not url:find("rbxasset") and getcustomasset then
		local ok, id = pcall(getcustomasset, url)
		if ok and id then url = id end
	end
	return url, a.ImageRectSize, a.ImageRectOffset or a.ImageRectPosition
end

local function mk(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			pcall(function() o[k] = v end)
		end
	end
	for _, c in ipairs(kids or {}) do
		c.Parent = o
	end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end

local function corner(p, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = p })
end

local function pad(p, n)
	return mk("UIPadding", {
		PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
		PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
		Parent = p,
	})
end

local function list(p, dir, gap)
	return mk("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = p,
	})
end

local function tween(o, t, props)
	local tw = TS:Create(o, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function setIcon(img, name, size)
	local url, rectSize, rectOff = iconAsset(name)
	if not url then
		img.Image = ""
		return
	end
	img.Image = url
	if rectSize then img.ImageRectSize = rectSize end
	if rectOff then img.ImageRectOffset = rectOff end
	if size then img.Size = UDim2.fromOffset(size, size) end
end

-- Theme
local Theme = {
	Bg = Color3.fromRGB(20, 20, 24),
	Panel = Color3.fromRGB(28, 28, 34),
	Text = Color3.fromRGB(240, 240, 245),
	Sub = Color3.fromRGB(160, 160, 175),
	Accent = Color3.fromRGB(90, 120, 255),
	Stroke = Color3.fromRGB(50, 50, 60),
}

local WindUI = { Version = "mini-1.0", Theme = Theme }

-- ScreenGui
local gui = mk("ScreenGui", {
	Name = "WindUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = true,
	Parent = (gethui and gethui()) or CoreGui,
})
pcall(function()
	if syn and syn.protect_gui then syn.protect_gui(gui) end
end)

function WindUI:Notify(cfg)
	cfg = cfg or {}
	local holder = gui:FindFirstChild("Notifs") or mk("Frame", {
		Name = "Notifs", BackgroundTransparency = 1,
		Size = UDim2.new(0, 300, 1, -40), Position = UDim2.new(1, -16, 0, 20),
		AnchorPoint = Vector2.new(1, 0), Parent = gui,
	})
	if not holder:FindFirstChildOfClass("UIListLayout") then
		list(holder, Enum.FillDirection.Vertical, 8)
		mk("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Parent = holder,
		})
	end
	local n = mk("Frame", {
		BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Parent = holder,
	})
	corner(n, 10)
	pad(n, 12)
	local row = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = n })
	list(row, Enum.FillDirection.Horizontal, 10)
	if cfg.Icon then
		local ic = mk("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(18, 18), Parent = row })
		setIcon(ic, cfg.Icon, 18)
	end
	local col = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -30, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row })
	list(col, nil, 2)
	mk("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		Text = cfg.Title or "Notify", Size = UDim2.new(1, 0, 0, 18), Parent = col,
	})
	if cfg.Content or cfg.Desc then
		mk("TextLabel", {
			BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12,
			TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true, Text = cfg.Content or cfg.Desc or "",
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = col,
		})
	end
	task.delay(cfg.Duration or 3, function()
		if n then n:Destroy() end
	end)
	return n
end

function WindUI:CreateWindow(cfg)
	cfg = cfg or {}
	local title = cfg.Title or "WindUI"
	local size = cfg.Size or UDim2.fromOffset(560, 400)
	local closed = false

	local main = mk("Frame", {
		Name = "Window", BackgroundColor3 = Theme.Bg,
		Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0),
		Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = gui, Visible = true,
	})
	corner(main, 14)
	mk("UIStroke", { Color = Theme.Stroke, Thickness = 1, Parent = main })

	-- Topbar
	local top = mk("Frame", {
		BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, cfg.Topbar and cfg.Topbar.Height or 44),
		Parent = main,
	})
	corner(top, 14)
	mk("Frame", { BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14), BorderSizePixel = 0, Parent = top })

	local left = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -80, 1, 0), Parent = top })
	list(left, Enum.FillDirection.Horizontal, 10)
	pad(left, 0)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 12), Parent = left })
	mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = left,
	})

	if cfg.Icon then
		local ic = mk("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), Parent = left })
		setIcon(ic, cfg.Icon, 20)
	end
	mk("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 15,
		TextColor3 = Theme.Text, Text = title, Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Left, Parent = left,
	})

	local right = mk("Frame", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(70, 1),
		Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = top,
	})
	list(right, Enum.FillDirection.Horizontal, 6)
	mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = right,
	})

	local function topBtn(txt, cb)
		local b = mk("TextButton", {
			Text = txt, Font = Enum.Font.GothamBold, TextSize = 14,
			TextColor3 = Theme.Sub, BackgroundColor3 = Theme.Bg,
			Size = UDim2.fromOffset(28, 28), Parent = right, AutoButtonColor = false,
		})
		corner(b, 8)
		b.MouseButton1Click:Connect(cb)
		return b
	end

	-- Sidebar + content
	local body = mk("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -(cfg.Topbar and cfg.Topbar.Height or 44)),
		Position = UDim2.new(0, 0, 0, cfg.Topbar and cfg.Topbar.Height or 44),
		Parent = main,
	})

	local sideW = cfg.SideBarWidth or 160
	local side = mk("ScrollingFrame", {
		BackgroundTransparency = 1, Size = UDim2.new(0, sideW, 1, 0),
		ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = body,
	})
	pad(side, 8)
	list(side, nil, 4)

	local content = mk("Frame", {
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, -sideW - 8, 1, -8),
		Position = UDim2.new(0, sideW + 4, 0, 4),
		Parent = body,
	})
	corner(content, 12)

	local pages = {}
	local selected

	local Window = {
		UIElements = { Main = main },
		Tabs = {},
	}

	function Window:Tab(t)
		t = t or {}
		local btn = mk("TextButton", {
			Text = "", BackgroundColor3 = Theme.Bg, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34), Parent = side, AutoButtonColor = false,
		})
		corner(btn, 8)
		local row = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = btn })
		list(row, Enum.FillDirection.Horizontal, 8)
		mk("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = row })
		mk("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center, Parent = row,
		})
		if t.Icon then
			local ic = mk("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Parent = row })
			setIcon(ic, t.Icon, 16)
		end
		mk("TextLabel", {
			BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13,
			TextColor3 = Theme.Sub, Text = t.Title or "Tab",
			Size = UDim2.new(1, -24, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
		})

		local page = mk("ScrollingFrame", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
			ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Stroke,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false, Parent = content,
		})
		pad(page, 14)
		list(page, nil, 8)

		local tab = { Title = t.Title, Button = btn, Page = page, Elements = {} }

		local function select()
			for _, ot in pairs(pages) do
				ot.Page.Visible = false
				ot.Button.BackgroundTransparency = 1
				local lab = ot.Button:FindFirstChildWhichIsA("TextLabel", true)
			end
			page.Visible = true
			btn.BackgroundTransparency = 0.3
			selected = tab
		end
		btn.MouseButton1Click:Connect(select)
		table.insert(pages, tab)
		if #pages == 1 then select() end

		local function add(class, props, build)
			props = props or {}
			local el = mk("Frame", {
				BackgroundColor3 = Theme.Bg, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y, Parent = page,
			})
			corner(el, 10)
			pad(el, 12)
			local api = build(el, props)
			table.insert(tab.Elements, api)
			return api
		end

		function tab:Button(p)
			p = p or {}
			return add("Button", p, function(el)
				local b = mk("TextButton", {
					Text = p.Title or "Button", Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = Theme.Text, BackgroundColor3 = p.Color or Theme.Accent,
					Size = UDim2.new(1, 0, 0, 32), Parent = el, AutoButtonColor = false,
				})
				corner(b, 8)
				b.MouseButton1Click:Connect(function()
					if p.Callback then p.Callback() end
				end)
				return { Instance = b }
			end)
		end

		function tab:Toggle(p)
			p = p or {}
			local state = p.Value == true
			return add("Toggle", p, function(el)
				local row = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Parent = el })
				mk("TextLabel", {
					BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = Theme.Text, Text = p.Title or "Toggle",
					Size = UDim2.new(1, -50, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
				})
				local box = mk("Frame", {
					BackgroundColor3 = state and Theme.Accent or Theme.Stroke,
					Size = UDim2.fromOffset(40, 22), Position = UDim2.new(1, 0, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5), Parent = row,
				})
				corner(box, 11)
				local knob = mk("Frame", {
					BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(16, 16),
					Position = UDim2.new(state and 1 or 0, state and -3 or 3, 0.5, 0),
					AnchorPoint = Vector2.new(state and 1 or 0, 0.5), Parent = box,
				})
				corner(knob, 8)
				local function set(v)
					state = v and true or false
					tween(box, 0.15, { BackgroundColor3 = state and Theme.Accent or Theme.Stroke })
					tween(knob, 0.15, {
						Position = UDim2.new(state and 1 or 0, state and -3 or 3, 0.5, 0),
						AnchorPoint = Vector2.new(state and 1 or 0, 0.5),
					})
					if p.Callback then p.Callback(state) end
				end
				mk("TextButton", {
					Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row,
				}).MouseButton1Click:Connect(function() set(not state) end)
				return { Set = set, Get = function() return state end }
			end)
		end

		function tab:Paragraph(p)
			p = p or {}
			return add("Paragraph", p, function(el)
				if p.Title then
					mk("TextLabel", {
						BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14,
						TextColor3 = Theme.Text, Text = p.Title, TextXAlignment = Enum.TextXAlignment.Left,
						Size = UDim2.new(1, 0, 0, 20), Parent = el,
					})
				end
				if p.Desc or p.Content then
					mk("TextLabel", {
						BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12,
						TextColor3 = Theme.Sub, Text = p.Desc or p.Content, TextWrapped = true,
						TextXAlignment = Enum.TextXAlignment.Left,
						Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = el,
					})
				end
				return {}
			end)
		end

		function tab:Space()
			mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 4), Parent = page })
		end

		function tab:Section(p)
			p = p or {}
			mk("TextLabel", {
				BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13,
				TextColor3 = Theme.Sub, Text = p.Title or "Section",
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, 0, 0, 22), Parent = page,
			})
			return tab
		end

		table.insert(Window.Tabs, tab)
		return tab
	end

	function Window:Section(p)
		-- sidebar section label
		p = p or {}
		mk("TextLabel", {
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11,
			TextColor3 = Theme.Sub, Text = string.upper(p.Title or ""),
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 20), Parent = side,
		})
		return {
			Tab = function(_, t) return Window:Tab(t) end,
		}
	end

	function Window:SelectTab(i)
		if pages[i] then pages[i].Button.MouseButton1Click:Fire() end
	end

	function Window:Open()
		closed = false
		main.Visible = true
		tween(main, 0.35, { Size = size })
	end

	function Window:Close()
		closed = true
		local tw = tween(main, 0.25, { Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0) })
		tw.Completed:Connect(function()
			if closed then main.Visible = false end
		end)
	end

	function Window:Toggle()
		if closed or not main.Visible then Window:Open() else Window:Close() end
	end

	function Window:Destroy()
		main:Destroy()
	end

	function Window:SetToggleKey(key)
		UIS.InputBegan:Connect(function(inp, gp)
			if gp then return end
			if inp.KeyCode == key then Window:Toggle() end
		end)
	end

	-- drag
	do
		local dragging, startPos, startInput
		top.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				startPos = main.Position
				startInput = inp.Position
			end
		end)
		UIS.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UIS.InputChanged:Connect(function(inp)
			if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
				local d = inp.Position - startInput
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end

	topBtn("—", function() Window:Close() end)
	topBtn("×", function() Window:Destroy() end)

	task.defer(function() Window:Open() end)
	WindUI.Window = Window
	return Window
end

function WindUI:Popup(cfg)
	cfg = cfg or {}
	WindUI:Notify({ Title = cfg.Title, Content = cfg.Content, Icon = cfg.Icon, Duration = 4 })
end

return WindUI
